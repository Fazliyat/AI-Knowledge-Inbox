# Copy this file to backend/.env and keep the actual API key out of source control.
PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SYSTEM_INSTRUCTION=
# Maximum original-file upload size in bytes (default 25 MiB; maximum 100 MiB).
DOCUMENT_MAX_UPLOAD_BYTES=26214400
# Optional absolute storage directory. Defaults to backend/uploads.
# DOCUMENT_STORAGE_DIR=
